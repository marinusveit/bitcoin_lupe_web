---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/700.css';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { getCollection } from 'astro:content';
import { extraNav } from '../lib/nav';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Die technischen Grundlagen von Bitcoin, anschaulich erklärt.' } = Astro.props;

const kapitel = (await getCollection('kapitel', (k) => !k.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · Bitcoin unter der Lupe</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a href="/" class="brand" aria-label="Bitcoin unter der Lupe, Startseite">
          <span class="coin" aria-hidden="true">₿</span>
          <span class="brand-text">Bitcoin unter der Lupe</span>
        </a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav" id="menu-toggle">Menü</button>
        <nav id="site-nav" class="site-nav" aria-label="Hauptnavigation">
          <ol>
            {kapitel.map((k, i) => (
              <li>
                <a
                  href={`/kapitel/${k.id}/`}
                  title={k.data.title}
                  aria-current={isActive(`/kapitel/${k.id}/`) ? 'page' : undefined}
                ><span class="num">{i + 1}</span> {k.data.navTitle ?? k.data.title}</a>
              </li>
            ))}
          </ol>
          <ul>
            {extraNav.map((n) => (
              <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        Lehrmaterial auf Grundlage der Bachelorarbeit „Bitcoin unter der Lupe“ (Hochschule München, 2024).
        Läuft vollständig im Browser, es werden keine Daten übertragen.
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const nav = document.getElementById('site-nav');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(!!open));
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; gap: 1.25rem; min-height: 3.4rem; }
  .brand {
    display: inline-flex; align-items: center; gap: 0.5rem; flex: none;
    font-weight: 600; color: var(--fg); text-decoration: none; white-space: nowrap;
  }
  .coin {
    display: inline-grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%;
    background: var(--accent); color: var(--on-accent); font-weight: 700;
  }
  .menu-toggle { margin-left: auto; display: none; }
  .site-nav { flex: 1; display: flex; gap: 0.75rem; align-items: center; justify-content: space-between; min-width: 0; }
  .site-nav ol, .site-nav ul { list-style: none; display: flex; gap: 0.1rem; margin: 0; padding: 0; }
  .site-nav a {
    display: inline-block; padding: 0.4rem 0.45rem 0.3rem; color: var(--fg-muted);
    text-decoration: none; font-size: 0.9rem; white-space: nowrap;
    border-bottom: 2px solid transparent;
  }
  .num { font-family: var(--font-mono); font-size: 0.85em; }
  .site-nav a:hover { color: var(--fg); border-bottom-color: var(--border); }
  .site-nav a[aria-current="page"] { color: var(--fg); border-bottom-color: var(--accent); }

  main { padding: 1.5rem var(--gutter) 4rem; }
  .site-footer { border-top: 1px solid var(--border); color: var(--fg-muted); font-size: 0.88rem; padding: 1.5rem 0 2.5rem; }

  /* Zwischen Menügrenze und voller Breite nur die Münze als Marke, damit die Zeile nicht umbricht. */
  @media (max-width: 1100px) and (min-width: 901px) {
    .brand-text { display: none; }
  }

  @media (max-width: 900px) {
    .bar { flex-wrap: wrap; }
    .menu-toggle { display: inline-block; }
    .site-nav { display: none; flex: none; width: 100%; flex-direction: column; align-items: stretch; padding-bottom: 0.8rem; }
    .site-nav.open { display: flex; }
    .site-nav ol, .site-nav ul { flex-direction: column; }
    .site-nav a { display: block; border-bottom: 0; border-left: 2px solid transparent; padding: 0.45rem 0.6rem; }
    .site-nav a:hover { border-left-color: var(--border); }
    .site-nav a[aria-current="page"] { border-left-color: var(--accent); }
  }
</style>
