---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { getCollection } from 'astro:content';
import { extraNav } from '../lib/nav';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Die technischen Grundlagen von Bitcoin, anschaulich erklärt.' } = Astro.props;

const kapitel = (await getCollection('kapitel', (k) => !k.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · Bitcoin unter der Lupe</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a href="/" class="brand">
          <span class="coin" aria-hidden="true">₿</span>
          <span>Bitcoin unter der Lupe</span>
        </a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav" id="menu-toggle">Menü</button>
        <nav id="site-nav" class="site-nav" aria-label="Hauptnavigation">
          <ol>
            {kapitel.map((k) => (
              <li>
                <a href={`/kapitel/${k.id}/`} aria-current={isActive(`/kapitel/${k.id}/`) ? 'page' : undefined}>
                  {k.data.title}
                </a>
              </li>
            ))}
          </ol>
          <ul>
            {extraNav.map((n) => (
              <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        Lehrmaterial auf Grundlage der Bachelorarbeit „Bitcoin unter der Lupe“ (Hochschule München, 2024).
        Läuft vollständig im Browser, es werden keine Daten übertragen.
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const nav = document.getElementById('site-nav');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(!!open));
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; gap: 1rem; min-height: 3.4rem; flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; color: var(--fg); text-decoration: none; }
  .coin {
    display: inline-grid; place-items: center; width: 1.7rem; height: 1.7rem; border-radius: 50%;
    background: var(--accent); color: #1d1d1b; font-weight: 800;
  }
  .menu-toggle { margin-left: auto; display: none; }
  .site-nav { margin-left: auto; display: flex; gap: 1rem; align-items: center; }
  .site-nav ol, .site-nav ul { list-style: none; display: flex; gap: 0.2rem; margin: 0; padding: 0; flex-wrap: wrap; }
  .site-nav ol { counter-reset: kap; }
  .site-nav ol li { counter-increment: kap; }
  .site-nav a {
    display: inline-block; padding: 0.35rem 0.55rem; border-radius: 6px; color: var(--fg-muted);
    text-decoration: none; font-size: 0.92rem;
  }
  .site-nav ol a::before { content: counter(kap) " "; color: var(--accent); font-weight: 700; }
  .site-nav a:hover { background: var(--bg-muted); color: var(--fg); }
  .site-nav a[aria-current="page"] { background: var(--accent-soft); color: var(--fg); }
  .site-nav ul a { border: 1px solid var(--border); }

  main { padding: 1.5rem var(--gutter) 4rem; }
  .site-footer { border-top: 1px solid var(--border); color: var(--fg-muted); font-size: 0.88rem; padding: 1.5rem 0 2.5rem; }

  @media (max-width: 900px) {
    .menu-toggle { display: inline-block; }
    .site-nav { display: none; width: 100%; flex-direction: column; align-items: stretch; padding-bottom: 0.8rem; }
    .site-nav.open { display: flex; }
    .site-nav ol, .site-nav ul { flex-direction: column; }
  }
</style>
