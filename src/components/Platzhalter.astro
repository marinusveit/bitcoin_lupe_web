---
/** Markiert die Stelle, an der eine interaktive Visualisierung eingebaut wird. */
interface Props { name: string; hinweis?: string }
const { name, hinweis } = Astro.props;
---
<div class="platzhalter" role="note">
  <strong>Visualisierung „{name}“</strong>
  {hinweis && <span> · {hinweis}</span>}
</div>
<style>
  .platzhalter {
    border: 2px dashed var(--border); border-radius: var(--radius); padding: 1rem;
    margin: 1.2rem 0; color: var(--fg-muted); background: var(--bg-muted);
  }
</style>
