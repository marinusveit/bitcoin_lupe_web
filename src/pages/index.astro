---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const kapitel = (await getCollection('kapitel', (k) => !k.data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Start">
  <section class="hero">
    <h1>Wie funktioniert Bitcoin wirklich?</h1>
    <p class="lead">
      Ohne Bank, ohne Chef, ohne Vertrauen in Fremde: Bitcoin hält seit 2009 ein digitales Kassenbuch,
      das niemand allein kontrolliert. Hier siehst du Schritt für Schritt, welche Technik das möglich macht,
      und kannst jeden Baustein selbst ausprobieren.
    </p>
    <p><a class="btn primary" href="/simulator/">Zum Netzwerk-Simulator</a></p>
  </section>

  <section>
    <h2>Kapitel</h2>
    <ol class="grid">
      {kapitel.map((k) => (
        <li class="card">
          <a href={`/kapitel/${k.id}/`}><strong>{k.data.title}</strong></a>
          <p>{k.data.summary}</p>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .hero { max-width: 46rem; padding: 2rem 0 1rem; }
  .lead { font-size: 1.15rem; color: var(--fg-muted); }
  .grid { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); }
  .grid li p { margin: 0.4rem 0 0; color: var(--fg-muted); font-size: 0.95rem; }
  .grid a { text-decoration: none; color: var(--fg); }
</style>
