---
import Base from '../layouts/Base.astro';
import Simulator from '../components/sim/Simulator.svelte';
---

<Base title="Netzwerk-Simulator" description="Ein vereinfachtes Bitcoin-Netzwerk zum Ausprobieren: Transaktionen, Miner, Gabelungen und ein Double-Spend-Angriff.">
  <h1>Netzwerk-Simulator</h1>
  <p class="prose">
    Hier arbeitet ein kleines Bitcoin-Netz direkt in deinem Browser. Wallets schicken Coins, Knoten reichen die
    Nachrichten weiter, und Miner suchen um die Wette nach dem nächsten Block. Die Zeit läuft in Ticks: Ein Tick ist
    der kleinste Zeitschritt der Simulation. Drücke Start und schau zu, oder greif selbst ein.
  </p>
  <!-- Platzhalter in etwa der Höhe des Simulators, damit die Fußzeile beim Laden nicht springt (ux-14). -->
  <Simulator client:only="svelte"><p slot="fallback" class="sim-laedt">Simulator wird geladen …</p></Simulator>
</Base>

<style>
  .sim-laedt {
    min-height: 70rem;
    margin: 1.5rem 0;
    color: var(--fg-muted);
  }
  @media (min-width: 60rem) {
    .sim-laedt {
      min-height: 40rem;
    }
  }
</style>
