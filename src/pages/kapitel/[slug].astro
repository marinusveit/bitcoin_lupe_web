---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const kapitel = await getCollection('kapitel', (k) => !k.data.draft);
  return kapitel.map((k) => ({ params: { slug: k.id }, props: { entry: k } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const alle = (await getCollection('kapitel', (k) => !k.data.draft)).sort((a, b) => a.data.order - b.data.order);
const idx = alle.findIndex((k) => k.id === entry.id);
const prev = idx > 0 ? alle[idx - 1] : undefined;
const next = idx < alle.length - 1 ? alle[idx + 1] : undefined;
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="kapitel">
    <p class="kicker">Kapitel {idx + 1} von {alle.length}</p>
    <h1>{entry.data.title}</h1>
    <p class="summary">{entry.data.summary}</p>
    <Content />
  </article>
  <nav class="pager" aria-label="Kapitelnavigation">
    {prev ? <a class="zurueck" href={`/kapitel/${prev.id}/`}>Zurück: {prev.data.title}</a> : <span />}
    {next ? <a class="weiter" href={`/kapitel/${next.id}/`}>Weiter: {next.data.title}</a> : <a class="weiter" href="/simulator/">Weiter: Netzwerk-Simulator</a>}
  </nav>
</Base>

<style>
  /* Text in der Spalte --measure, Werkbank-Rahmen darf bis --bench breit werden. */
  .kapitel { max-width: var(--bench); }
  .kapitel > :global(*) { max-width: var(--measure); }
  .kapitel > :global(.werkbank) { max-width: var(--bench); }
  .kicker { font-family: var(--font-mono); font-size: 0.85rem; color: var(--fg-muted); margin: 0.5rem 0 0; }
  .kicker + h1 { margin-top: 0.3rem; }
  .summary { font-size: 1.1rem; color: var(--fg-muted); }
  .pager {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    max-width: var(--measure); margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--border);
  }
  .weiter { margin-left: auto; text-align: right; font-weight: 600; }
</style>
